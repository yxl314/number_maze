---
# 只检查本项目 src/ 下的源码和头文件。Qt 自身头文件、系统头文件和
# third_party 不进入诊断。正则同时允许 ./ 和 ../ 前缀，但不允许
# src/../third_party 这类借道 src 的路径。
Checks: '-*,bugprone-*,performance-*,portability-*,cert-*,-bugprone-easily-swappable-parameters,-performance-enum-size'
HeaderFilterRegex: '^(\./|\.\./)*src/([^.]|\.[^./])'
SystemHeaders: false
FormatStyle: file
